{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension: Notebook Test",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}",
        "${workspaceFolder}/test/test.ipynb"
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: compile",
      "presentation": {
        "group": "extension",
        "order": 1
      }
    },
    {
      "name": "Run Extension: Empty Host",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: compile",
      "presentation": {
        "group": "extension",
        "order": 2
      }
    }
  ]
}
