{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/jupyter-config-cells/config-cell.schema.json",
  "title": "Jupyter Config Cell Metadata",
  "type": "object",
  "required": ["version", "name", "language"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "enum": ["yaml", "json", "jsonc", "toml", "dotenv"]
    },
    "schema": {
      "type": "string"
    },
    "exportPath": {
      "type": "string"
    },
    "autoValidate": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
